diff --git a/aide/backend/backend_claude_cli.py b/aide/backend/backend_claude_cli.py
new file mode 100644
--- /dev/null
+++ b/aide/backend/backend_claude_cli.py
@@ -0,0 +1,43 @@
+"""Backend for the local `claude -p` CLI (no API key; poc fork)."""
+
+import json
+import subprocess
+import time
+import os
+import signal
+
+from .utils import FunctionSpec, OutputType
+
+
+def query(
+    system_message: str | None,
+    user_message: str | None,
+    func_spec: FunctionSpec | None = None,
+    **model_kwargs,
+) -> tuple[OutputType, float, int, int, dict]:
+    if func_spec is not None:
+        raise NotImplementedError("claude-cli backend does not support function calling")
+    model = str(model_kwargs.get("model", "")).removeprefix("claude-cli:")
+    prompt = "\n\n".join(m for m in (system_message, user_message) if m)
+    t0 = time.time()
+    command = ["claude", "-p", prompt, "--output-format", "json", "--model", model]
+    if model_kwargs.get("isolated"):
+        command += ["--safe-mode", "--tools", "", "--no-session-persistence", "--strict-mcp-config",
+                    "--system-prompt", "Follow only the supplied experiment JSON. Return the requested JSON proposal."]
+    proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+                            cwd=model_kwargs.get("cwd"), start_new_session=True)
+    try:
+        stdout, stderr = proc.communicate(timeout=model_kwargs.get("timeout"))
+    except subprocess.TimeoutExpired:
+        os.killpg(proc.pid, signal.SIGKILL)
+        proc.communicate()
+        raise
+    if proc.returncode:
+        raise subprocess.CalledProcessError(proc.returncode, command, stdout, stderr)
+    out = json.loads(stdout)
+    if out.get("is_error") is True:
+        raise RuntimeError("claude CLI failed: " + str(out.get("result", "unknown error")))
+    usage = out.get("usage") or {}
+    info = {"cost_usd": out.get("total_cost_usd"), "session_id": out.get("session_id"),
+            "usage": usage or "unavailable", "isolated": bool(model_kwargs.get("isolated"))}
+    return out["result"], time.time() - t0, usage.get("input_tokens"), usage.get("output_tokens"), info
