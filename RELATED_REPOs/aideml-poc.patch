+[project]
+name = "aideml"
+version = "0.2.2+poc"
+description = "AIDE v0.2.2 + claude-cli backend, core dependencies only (poc fork)"
+requires-python = ">=3.10"
+dependencies = [
+  "openai>=1.69.0",
+  "anthropic>=0.20.0",
+  "omegaconf>=2.3.0",
+  "dataclasses-json>=0.6.4",
+  "funcy>=2.0",
+  "backoff>=2.2",
+  "jsonschema>=4.19",
+  "numpy>=1.26",
+  "humanize>=4.8",
+]
+
+[build-system]
+requires = ["hatchling"]
+build-backend = "hatchling.build"
+
+# hatchling ignores the upstream setup.py / requirements.txt (79 Kaggle deps)
+[tool.hatch.build.targets.wheel]
+packages = ["aide"]
